# Скопируйте файл в .env и подставьте свои значения

# Секрет для подписи JWT. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Строка подключения к БД (асинхронный драйвер)
DATABASE_URL=sqlite+aiosqlite:///./portal.db

# Время жизни access-токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=480
