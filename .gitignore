# Окружение
venv/
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# База данных SQLite
*.db
# Файлы режима WAL: журнал и общая память, лежат рядом с базой
*.db-wal
*.db-shm

# Логи запуска
*.log
*.err

# Резервные копии портала: файлы собираются на компьютере портала,
# в репозитории им не место (там данные сотрудников и, возможно, секреты)
backups/

# Секреты внешних сервисов (OAuth-клиенты Google и т. п.)
client_secret_*.json

# Ключ OAuth-клиента и токен Google Календаря: только на компьютере портала
config/google_calendar/

# Локальная диагностика вёрстки (layout probe)
app/static/_probe.html

# Редакторы / ОС
.vscode/
.idea/
Thumbs.db
